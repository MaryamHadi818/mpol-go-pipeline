\fs26 \cf3 \cb7 \strokec3 Results are split into Biological Process (BP), Molecular Function (MF), and Cellular Component (CC) sub-tables. All output TSVs include GO ID, term name, study/population counts, uncorrected p, FDR-corrected p, enrichment direction, and contributing gene IDs.\cb1 \
\pard\pardeftab720\partightenfactor0

\f3\fs24 \cf4 \cb9 \strokec4 # Inspect top enriched terms (uncorrected) across contrasts\cf3 \strokec3 \
\pard\pardeftab720\partightenfactor0
\cf8 \strokec8 import\cf3 \strokec3  pandas \cf8 \strokec8 as\cf3 \strokec3  pd\
\cf8 \strokec8 for\cf3 \strokec3  contrast \cf8 \strokec8 in\cf3 \strokec3  [\cf10 \strokec10 "LvsI"\cf3 \strokec3 , \cf10 \strokec10 "LvsT"\cf3 \strokec3 , \cf10 \strokec10 "TvsI"\cf3 \strokec3 ]:\
    df = pd.read_csv(\
        \cf11 \strokec11 f\cf10 \strokec10 "go_results/\{contrast\}_GO_all.tsv"\cf3 \strokec3 , sep=\cf10 \strokec10 "\\t"\cf3 \strokec3 \
    )\
    top = df[df[\cf10 \strokec10 "enrichment"\cf3 \strokec3 ] == \cf10 \strokec10 "e"\cf3 \strokec3 ].nsmallest(\
        \cf11 \strokec11 10\cf3 \strokec3 , \cf10 \strokec10 "p_uncorrected"\cf3 \strokec3 \
    )\
    print(top[[\cf10 \strokec10 "GO_ID"\cf3 \strokec3 ,\cf10 \strokec10 "NS"\cf3 \strokec3 ,\cf10 \strokec10 "GO_name"\cf3 \strokec3 ,\cf10 \strokec10 "p_uncorrected"\cf3 \strokec3 ]])\
